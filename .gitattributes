# Store text canonically as LF; let Git checkout native line endings where appropriate.
* text=auto

*.py     text eol=lf
*.ts     text eol=lf
*.svelte text eol=lf
*.css    text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf
*.toml   text eol=lf
*.json   text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.db binary
*.db-wal binary
*.db-shm binary
