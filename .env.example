# Runtime SQLite database used by Falcon.
# Defaults to ./data/prices.db when unset.
PRICES_DB_PATH=

# Optional raw CSV fallback root supplied by the inflationstudymirror data repo.
# Defaults to ./data/raw when unset.
INFLATION_DATA_ROOT=

# Optional EpeyKatfg monthly inflation artifact supplied by the data repo.
# Defaults to ./data/inflation/EpeyKatfg/monthly_inflation.csv when unset.
EPEYKATFG_MONTHLY_CSV=

# Falcon networking
FALCON_CORS_ORIGINS=http://localhost:5173
FALCON_INTERFACE=wsgi
FALCON_DATA_VERSION=1

# SQLite read tuning
SQLITE_BUSY_TIMEOUT=5000
SQLITE_CACHE_SIZE=-128000
SQLITE_MMAP_SIZE=1073741824

# Optional ASGI / Redis stack
REDIS_URL=redis://127.0.0.1:6379/0
FALCON_RATE_LIMIT_ENABLED=1
