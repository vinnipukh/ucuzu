# Falcon API base URL used by the dashboard, baked in at build time.
# Empty or unset (the default) means same origin: the SPA calls /api/...,
# which the Vite dev proxy forwards to http://localhost:8000 and a production
# reverse proxy routes to the Falcon server. Set a full URL (for example
# https://api.example.com) only when the API is on another origin, and allow
# the SPA's origin in FALCON_CORS_ORIGINS.
VITE_API_BASE_URL=
